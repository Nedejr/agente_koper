# ============================================
# OPENROUTER - Cloud LLM API
# ============================================
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here
# Default model (free models available)
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-8b-instruct:free

# ============================================
# QDRANT - Vector Store
# ============================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=koper_knowledge

# ============================================
# BACKEND CONFIGURATION
# ============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ============================================
# EMBEDDINGS
# ============================================
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================
# RAG SETTINGS
# ============================================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
MIN_SCORE=0.6

# ============================================
# AGENT SETTINGS
# ============================================
CLASSIFIER_THRESHOLD=0.6
EVALUATOR_MIN_CONFIDENCE=0.7
